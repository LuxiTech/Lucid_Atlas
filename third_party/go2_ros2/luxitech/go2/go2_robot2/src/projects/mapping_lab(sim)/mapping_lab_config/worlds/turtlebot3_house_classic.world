<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtlebot3_house_classic">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://turtlebot3_house</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.5 -0.8 7.5 0 1.45 0.05</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
