<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtlebot3_world_classic">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://turtlebot3_world</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-2.4 -2.8 1.5 0 0.32 0.8</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
