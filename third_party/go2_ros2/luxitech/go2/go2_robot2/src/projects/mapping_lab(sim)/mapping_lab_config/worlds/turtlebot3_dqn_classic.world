<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtlebot3_dqn_classic">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://turtlebot3_dqn_world</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-3.2 -3.0 2.2 0 0.45 0.7</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
