<launch>
  <arg name="rviz" default="false"/>

  <rosparam file="$(find fast_calib)/config/qr_params.yaml" command="load" subst_value="true"/>

  <node pkg="fast_calib" type="multi_fast_calib" name="multi_fast_calib" output="screen">
    <env name="LD_PRELOAD" value="/lib/x86_64-linux-gnu/libusb-1.0.so.0"/>
    <env name="LD_LIBRARY_PATH" value="/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/root/ws/catkin_ws/devel/lib:/opt/ros/noetic/lib:/usr/local/lib:/root/ws/MID360/install/livox_sdk2/lib:/root/ws/MID360/install/livox_ros_driver2/lib"/>
  </node>

  <group if="$(arg rviz)">
      <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_calib)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
